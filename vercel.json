{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev --ignore-scripts",
  "buildCommand": "echo 'nothing to build: index.html is prebuilt (npm run build)'",
  "outputDirectory": ".",
  "functions": { "api/chat.js": { "maxDuration": 60 }, "api/checkins.js": { "maxDuration": 30 }, "api/speak.js": { "maxDuration": 60 }, "api/quakes.js": { "maxDuration": 30 } },
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
