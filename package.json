{
  "name": "aftershock-reentry",
  "version": "3.3.0",
  "private": true,
  "description": "Aftershock shaking estimates for live USGS earthquakes and recorded case studies, with explicit uncertainty, source provenance and model validation limits.",
  "scripts": {
    "fetch": "node scripts/fetch_usgs.mjs",
    "prep": "node scripts/prep_basemap.js && node scripts/prep_population.js",
    "fit": "node scripts/python.mjs scripts/fit_site_term.py",
    "build": "node scripts/python.mjs scripts/build.py",
    "backtest": "node scripts/backtest.js",
    "test": "node --test",
    "check": "node scripts/check-build.js",
    "audit:data": "node scripts/audit-data.mjs",
    "db:setup": "node scripts/setup-checkins.js",
    "dev": "node scripts/dev.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "all-the-cities": "3.1.0",
    "cities.json": "1.1.50",
    "d3-array": "3.2.4",
    "d3-geo": "3.1.1",
    "geotiff": "2.1.3",
    "leaflet": "1.9.4",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
