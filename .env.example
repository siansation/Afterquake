# Copy to .env.local, which is ignored by Git. Never commit a real password.
TIGER_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=verify-full
# Optional trusted CA certificate for a service using a private/self-signed CA.
# TIGER_DATABASE_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Natural voice for Read summary (api/speak.js). Never commit a real key.
ELEVENLABS_API_KEY=your-elevenlabs-key
# Optional: any voice ID from your ElevenLabs library (default: George, JBFqnCBsd6RMkjVDRZzb).
# ELEVENLABS_VOICE_ID=
# Optional: default eleven_flash_v2_5 (fast, 32 languages).
# ELEVENLABS_MODEL=
# Translation into the local language reuses the assistant's key.
# GEMINI_API_KEY=
# Defaults: a primary model plus a backup for temporary overloads.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMINI_THINKING=minimal
